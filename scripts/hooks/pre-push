#!/usr/bin/env bash
# src-lint managed Git hook

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT

check_dependencies() {
  command -v codependence >/dev/null || {
    printf 'pre-push: run brew bundle --file=scripts/Brewfile to install codependence\n' >&2
    return 1
  }
  local token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  local api_url="${GITHUB_API_URL:-https://api.github.com}"
  if [[ -z "$token" && "$api_url" == https://api.github.com ]] &&
    command -v gh >/dev/null 2>&1; then
    token="$(gh auth token --hostname github.com 2>/dev/null)" || token=""
  fi
  GH_TOKEN="$token" codependence --noCache --format table
}

cd "$REPO_ROOT"
check_dependencies
cmake -DSUITE=release -P "$REPO_ROOT/scripts/run-tests.cmake"
cmake -DSUITE=sanitizers -P "$REPO_ROOT/scripts/run-tests.cmake"
