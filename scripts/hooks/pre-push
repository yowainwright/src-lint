#!/usr/bin/env bash
# src-lint managed Git hook

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT

can_use_gh_auth() {
  [[ -z "${1:-}" && "${2:?}" == https://api.github.com ]] &&
    command -v gh >/dev/null 2>&1
}

require_codependence() {
  command -v codependence >/dev/null && return 0
  printf 'pre-push: run brew bundle --file=scripts/Brewfile to install codependence\n' >&2
  return 1
}

check_dependencies() {
  require_codependence
  local token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  local api_url="${GITHUB_API_URL:-https://api.github.com}"
  if can_use_gh_auth "$token" "$api_url"; then
    token="$(gh auth token --hostname github.com 2>/dev/null)" || token=""
  fi
  GH_TOKEN="$token" codependence --noCache --format table
}

main() {
  cd "$REPO_ROOT"
  check_dependencies
}

main "$@"
