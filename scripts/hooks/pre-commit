#!/usr/bin/env bash
# src-lint managed Git hook

set -euo pipefail

export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT

require_clang_format() {
  command -v clang-format >/dev/null && return 0
  printf 'pre-commit: clang-format is required\n' >&2
  return 1
}

format_staged_sources() {
  local -a staged_sources=()
  local path
  while IFS= read -r -d '' path; do
    [[ ! -f "$path" ]] || staged_sources+=("$path")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.c' '*.h')
  ((${#staged_sources[@]} > 0)) || return 0
  require_clang_format
  clang-format "--style=file:$REPO_ROOT/scripts/.clang-format" --dry-run --Werror "${staged_sources[@]}"
}

main() {
  exec </dev/null
  cd "$REPO_ROOT"
  git diff --cached --check
  format_staged_sources
  cmake -DSUITE=debug -P "$REPO_ROOT/scripts/run-tests.cmake"
}

main "$@"
