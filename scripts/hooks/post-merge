#!/usr/bin/env bash
# src-lint managed Git hook

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT

check_dependencies() {
  command -v brew >/dev/null || return 0
  [[ -f scripts/Brewfile ]] || return 0
  brew bundle check --file=scripts/Brewfile >/dev/null || {
    printf 'post-merge: run brew bundle --file=scripts/Brewfile to install local tools\n' >&2
  }
}

main() {
  cd "$REPO_ROOT"
  check_dependencies
  ./scripts/setup.sh >/dev/null
}

main "$@"
