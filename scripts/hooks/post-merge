#!/usr/bin/env bash
# src-lint managed Git hook

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT

cd "$REPO_ROOT"

if command -v brew >/dev/null && [[ -f scripts/Brewfile ]]; then
  brew bundle check --file=scripts/Brewfile >/dev/null || {
    printf 'post-merge: run brew bundle --file=scripts/Brewfile to install local tools\n' >&2
  }
fi

./scripts/setup.sh >/dev/null
