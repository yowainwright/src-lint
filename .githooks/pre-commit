#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly REPO_ROOT
readonly BUILD_DIR="$REPO_ROOT/build-hooks-debug"

format_staged_sources() {
  local -a staged_sources=()
  local path
  while IFS= read -r -d '' path; do
    [[ ! -f "$path" ]] || staged_sources+=("$path")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.c' '*.h')
  (( ${#staged_sources[@]} > 0 )) || return 0
  command -v clang-format >/dev/null || {
    printf 'pre-commit: clang-format is required\n' >&2
    return 1
  }
  clang-format --dry-run --Werror "${staged_sources[@]}"
}

run_debug_tests() {
  cmake -S "$REPO_ROOT" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Debug
  cmake --build "$BUILD_DIR" --parallel
  ctest --test-dir "$BUILD_DIR" --output-on-failure
}

cd "$REPO_ROOT"
git diff --cached --check
format_staged_sources
run_debug_tests
